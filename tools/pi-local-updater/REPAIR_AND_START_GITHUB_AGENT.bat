@echo off
setlocal EnableExtensions DisableDelayedExpansion
cd /d "%~dp0"
if errorlevel 1 (echo Cannot enter application folder. & pause & exit /b 1)
if not exist ".\updater\cli.mjs" (echo Missing updater. Place this BAT beside START_WITH_AGENT.bat. & pause & exit /b 1)
if not exist ".\START_WITH_AGENT.bat" (echo Wrong application folder - no agent launcher. & pause & exit /b 1)
if not exist ".\START_LOCALHOST.bat" (echo Wrong application folder - no localhost launcher. & pause & exit /b 1)
if not exist ".\start.mjs" (echo Wrong application folder - no start.mjs. & pause & exit /b 1)
echo PRODUCT INSIGHTS - FIXED GITHUB UPDATER LAUNCHERS
echo This changes ONLY two startup BAT files. Existing copies are backed up.
echo Stop localhost on port 8791 before starting the repaired agent.
node.exe -e "const fs=require('node:fs');const path=require('node:path');const root=process.cwd();const fixes=[['START_GITHUB_AGENT.bat',''],['START_GITHUB_LOCALHOST.bat','']];const dir=path.join(root,'local-data','pi-updates','launcher-backups');fs.mkdirSync(dir,{recursive:true});const backup=fs.mkdtempSync(path.join(dir,'repair-'));const updated=[];try{for(const [name,b64] of fixes){const dst=path.join(root,name);const old=fs.existsSync(dst)?fs.readFileSync(dst):null;if(old){const s=old.toString('ascii');if(!s.includes('activate-if-staged')||!s.includes('updater')||!s.includes('START_'))throw Error('Refusing to overwrite an unrecognized launcher: '+name);fs.writeFileSync(path.join(backup,name),old)}const tmp=dst+'.pi-repair-'+process.pid;fs.writeFileSync(tmp,Buffer.from(b64,'base64'),{flag:'wx'});try{fs.renameSync(tmp,dst)}catch(e){fs.rmSync(tmp,{force:true});throw e}updated.push([dst,old])}}catch(e){for(const [dst,old] of updated.reverse()){if(old===null)fs.rmSync(dst,{force:true});else fs.writeFileSync(dst,old)}console.error('Repair failed: '+e.message);process.exitCode=1}if(!process.exitCode)console.log('Launchers repaired; backup saved in '+backup);"
if errorlevel 1 (echo Launcher repair blocked; no application started. & pause & exit /b 1)
if /i "%~1"=="/repair-only" exit /b 0
echo Starting the corrected GitHub updater and agent...
call ".\START_GITHUB_AGENT.bat"
exit /b %ERRORLEVEL%
