{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "product-insights-scrappers-prototype",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-10",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "services": [
    {
      "binding": "PATTERN_SERVICE",
      "service": "insidejob-pattern-systems"
    }
  ],
  "vars": {
    "ALLOWED_HOSTS": "www.saginawcontrol.com,www.dometic.com,pushcorp.com,www.proenergyservices.com,www.moog.com,www.generalkinematics.com,hennigworldwide.com,www.pentictonfoundry.com,vestil.com,bluerobotics.com,hytrol.com,whitedriveproducts.com,www.filamatic.com,www.epcpower.com",
    "PATTERN_API_URL": "https://insidejob-pattern-systems.injindiaops.workers.dev"
  },
  "ai": {
    "binding": "AI"
  }
}
