{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "product-insights-scrappers-prototype",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-10",
  "compatibility_flags": ["nodejs_compat_v2"],
  "vars": {"ALLOWED_HOSTS": "manufacturer.com"}
  // Optional Cloudflare deployment ONLY. See README; install wrangler and puppeteer 2.x separately.
  // Optional Browser Run: "browser": {"binding": "MYBROWSER"}
}
